<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="net.xiupos.Refdir" path="/net/xiupos/Refdir/">
    <key name="folder" type="s">
      <default>""</default>
      <summary>Library folder</summary>
      <description>The library shown. Empty: $REFDIR, if it is set.</description>
    </key>
    <key name="sort" type="s">
      <choices>
        <choice value="year"/>
        <choice value="title"/>
        <choice value="author"/>
        <choice value="key"/>
      </choices>
      <default>"year"</default>
      <summary>Order of the list</summary>
      <description>Newest first, by title, by first author, or by key.</description>
    </key>
    <key name="window-width" type="i">
      <default>1280</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>800</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
  </schema>
</schemalist>
